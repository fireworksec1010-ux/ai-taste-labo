  "dishes": [
    { "pref": "北海道", "region": "北海道・東北", "c": 13, "r": 0, "dish": "ちゃんちゃん焼き", "en": "Chan-chan yaki", "cat": "dish", "fun": false, "desc": "鮭と野菜を鉄板にのせ、味噌だれをかけて蒸し焼きにする漁師町生まれの料理。" },
    { "pref": "青森", "region": "北海道・東北", "c": 13, "r": 2, "dish": "せんべい汁", "en": "Senbei-jiru", "cat": "soup", "fun": true, "desc": "鍋用の南部せんべいを割り入れて煮込む八戸周辺の汁もの。煮えたせんべいがもちもちの食感になる。" },
    { "pref": "秋田", "region": "北海道・東北", "c": 12, "r": 3, "dish": "きりたんぽ鍋", "en": "Kiritanpo nabe", "cat": "nabe", "fun": false, "desc": "つぶしたご飯を杉の棒に巻いて焼いた「きりたんぽ」を、鶏だしで野菜と煮込む鍋。" },
    { "pref": "岩手", "region": "北海道・東北", "c": 13, "r": 3, "dish": "わんこそば", "en": "Wanko soba", "cat": "noodle", "fun": true, "desc": "給仕が一口分のそばを次々とお椀に入れ、お客がふたを閉めるまで続く盛岡・花巻のもてなし。" },
    { "pref": "山形", "region": "北海道・東北", "c": 12, "r": 4, "dish": "芋煮", "en": "Imoni", "cat": "soup", "fun": true, "desc": "里芋と牛肉（地域により豚肉）を煮る汁もの。秋には河原で大鍋を囲む「芋煮会」が開かれる。" },
    { "pref": "宮城", "region": "北海道・東北", "c": 13, "r": 4, "dish": "はらこ飯", "en": "Harako-meshi", "cat": "rice", "fun": false, "desc": "鮭の煮汁で炊いたご飯に、鮭の身といくら（はらこ）をのせる亘理町の秋の味。" },
    { "pref": "福島", "region": "北海道・東北", "c": 12, "r": 5, "dish": "こづゆ", "en": "Kozuyu", "cat": "soup", "fun": false, "desc": "会津の祝い膳に欠かせない汁もの。貝柱のだしに里芋や豆麩などを入れ、朱塗りの小さな椀で何杯もおかわりする。" },

    { "pref": "茨城", "region": "関東", "c": 13, "r": 6, "dish": "あんこう鍋", "en": "Anko nabe (monkfish hot pot)", "cat": "nabe", "fun": false, "desc": "冬が旬のあんこうを使う鍋。あん肝を炒って溶かし込む濃厚な「どぶ汁」は漁師流。" },
    { "pref": "栃木", "region": "関東", "c": 12, "r": 6, "dish": "しもつかれ", "en": "Shimotsukare", "cat": "dish", "fun": true, "desc": "鮭の頭、大豆、酒粕、粗くおろした大根などを煮る初午の行事食。見た目は独特だが栄養たっぷり。" },
    { "pref": "群馬", "region": "関東", "c": 11, "r": 6, "dish": "おっきりこみ", "en": "Okkirikomi", "cat": "noodle", "fun": false, "desc": "幅広の生麺を下ゆでせず、野菜たっぷりの汁で煮込む。小麦どころ群馬の家庭料理。" },
    { "pref": "埼玉", "region": "関東", "c": 11, "r": 7, "dish": "冷汁うどん", "en": "Hiyashiru udon", "cat": "noodle", "fun": false, "desc": "すりごまと味噌の冷たい汁にきゅうりや大葉を入れ、うどんをつけて食べる夏の料理。" },
    { "pref": "東京", "region": "関東", "c": 12, "r": 7, "dish": "深川めし", "en": "Fukagawa-meshi", "cat": "rice", "fun": false, "desc": "あさりを味噌などで煮た汁をご飯にかける（または炊き込む）、江戸の漁師町・深川の名物。" },
    { "pref": "千葉", "region": "関東", "c": 13, "r": 7, "dish": "なめろう", "en": "Namero", "cat": "dish", "fun": true, "desc": "アジなどの魚を味噌や薬味と一緒に包丁でたたいた房総の漁師料理。皿までなめたくなるうまさが名の由来とも。" },
    { "pref": "神奈川", "region": "関東", "c": 11, "r": 8, "dish": "けんちん汁", "en": "Kenchin-jiru", "cat": "soup", "fun": false, "desc": "豆腐と根菜をごま油で炒めてから煮る汁もの。鎌倉の建長寺が発祥という説がある。" },

    { "pref": "新潟", "region": "中部", "c": 11, "r": 5, "dish": "のっぺ", "en": "Noppe", "cat": "dish", "fun": false, "desc": "里芋のとろみが特徴の煮もの。正月やお祭りに大鍋で作り、冷やして食べることも多い。" },
