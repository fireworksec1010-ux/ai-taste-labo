    { "pref": "石川", "region": "中部", "c": 9, "r": 5, "dish": "治部煮", "en": "Jibuni", "cat": "dish", "fun": false, "desc": "小麦粉をまぶした鴨肉と麩、野菜を煮て、とろみのある汁ごといただく金沢の料理。" },
    { "pref": "福井", "region": "中部", "c": 8, "r": 6, "dish": "越前おろしそば", "en": "Echizen oroshi soba", "cat": "noodle", "fun": false, "desc": "冷たいそばに、辛味の効いた大根おろしとつゆをかけて食べる。" },
    { "pref": "山梨", "region": "中部", "c": 10, "r": 7, "dish": "ほうとう", "en": "Hoto", "cat": "noodle", "fun": false, "desc": "平たい太麺を、かぼちゃなどの野菜と一緒に味噌仕立ての汁で煮込む。" },
    { "pref": "長野", "region": "中部", "c": 10, "r": 6, "dish": "おやき", "en": "Oyaki", "cat": "sweet", "fun": false, "desc": "小麦粉などの生地で野沢菜や野菜のおかずを包み、焼いたり蒸したりしたもの。" },
    { "pref": "岐阜", "region": "中部", "c": 9, "r": 6, "dish": "朴葉味噌", "en": "Hoba miso", "cat": "dish", "fun": true, "desc": "大きな朴（ほお）の葉に味噌とねぎ、きのこをのせ、こんろで焼きながら食べる飛騨の料理。" },
