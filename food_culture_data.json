    { "pref": "京都", "region": "近畿", "c": 6, "r": 7, "dish": "にしんそば", "en": "Nishin soba", "cat": "noodle", "fun": false, "desc": "甘辛く煮た身欠きにしんを、温かいそばにのせた京都の名物。" },
    { "pref": "兵庫", "region": "近畿", "c": 5, "r": 7, "dish": "ぼたん鍋（いのしし鍋）", "en": "Botan nabe (wild boar hot pot)", "cat": "nabe", "fun": true, "desc": "猪肉を味噌仕立ての鍋で煮る丹波篠山の冬の名物。肉を牡丹の花のように盛り付けることが名の由来。" },
    { "pref": "大阪", "region": "近畿", "c": 5, "r": 8, "dish": "箱寿司", "en": "Hako-zushi (box sushi)", "cat": "rice", "fun": false, "desc": "木の箱に酢飯と具を詰めて押した、大阪の押し寿司。切り口の美しさも楽しむ。" },
